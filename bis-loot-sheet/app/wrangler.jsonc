{
  // Static-assets-only Worker: serves the Vite build, no server code.
  "name": "bis-loot-sheet",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Client-side app: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
