{
  // Static-assets-only Worker: serves the Vite build, no server code.
  "name": "bis-loot-sheet",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Client-side app: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
