          "check": "event",
          "custom": "@auto-shot-bar--triggers-1-trigger-custom.lua",
          "customDuration": "function()\n    return aura_env.duration, aura_env.expiration_time\nend",
          "customIcon": "function()\n    return aura_env.spell_icon\nend",
          "customName": "function()\n    return aura_env.spell_name\nend\n\n\n",
          "customOverlay1": "function()\n    return \"backward\", \"-\"..aura_env.pushback_total\nend",
          "custom_hide": "timed",
          "custom_type": "status",
          "debuffType": "HELPFUL",
          "duration": "3",
          "event": "Cast",
          "events": "CLEU:SPELL_CAST_START, CLEU:SPELL_CAST_SUCCESS, CLEU:SPELL_CAST_FAILED, CLEU:SWING_DAMAGE, CLEU:ENVIRONMENTAL_DAMAGE, CLEU:SPELL_DAMAGE",
          "names": [],
          "sourceUnit": "player",
          "spell": "aimed shot",
          "spellIds": [],
          "spellName": "Aimed Shot",
          "subeventPrefix": "SPELL",
          "subeventSuffix": "_CAST_START",
          "type": "custom",
          "unevent": "auto",
          "unit": "player",
          "use_cloneId": false,
          "use_sourceUnit": true,
          "use_spell": true,
          "use_spellName": true,
          "use_unit": true
        },
        "untrigger": {
          "custom": "function(event, _, cleu, _, _, source_name, _, _, _, _, _, _, _, spell_name, _, fail_type)\n    if source_name == UnitName(\"player\") and spell_name == aura_env.spell_name then\n        if cleu == \"SPELL_CAST_SUCCESS\" or (cleu == \"SPELL_CAST_FAILED\" and fail_type ~= getglobal(\"SPELL_FAILED_SPELL_IN_PROGRESS\")) then\n            aura_env.spell_name = nil\n            aura_env.casting = nil\n            return true\n        end\n    end\n    \n    if aura_env.expiration_time - GetTime() <= 0 then -- Fixes bar being stuck because SPELL_CAST_FAILED is not always fired\n        aura_env.spell_name = nil\n        aura_env.casting = nil\n        return true\n    end\nend"
        }
      },
      "2": {
        "trigger": {
          "custom": "@auto-shot-bar--triggers-2-trigger-custom.lua",
          "customDuration": "function()\n    local eWS = UnitRangedDamage(\"player\")\n    local haste = aura_env.haste() * (1 + GetRangedHaste() / 100)\n    local duration = eWS - .5 / haste\n    return duration, GetTime() + duration\nend\n\n\n",
          "custom_hide": "timed",
          "custom_type": "event",
          "debuffType": "HELPFUL",
          "dynamicDuration": true,
          "event": "Swing Timer",
          "events": "UNIT_SPELLCAST_SUCCEEDED:player",
          "hand": "ranged",
          "type": "custom",
          "unit": "player",
          "use_hand": true,
          "use_inverse": false,
          "use_remaining": false,
          "use_unit": true
        },
